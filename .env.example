# ---------------------------------------------------------------- core
NODE_ENV=development
# Public origin users open (web + /v1 share one origin via the Vite proxy or your ingress).
# Spotify requires loopback redirect URIs to use 127.0.0.1, not localhost.
PUBLIC_ORIGIN=http://127.0.0.1:5173
# Split hosting (web on a CDN, API elsewhere): extra web origins allowed to open the live socket,
# comma-separated, and (web build) the API's socket origin, e.g. wss://spinroom-api.onrender.com.
WEB_ORIGINS=
VITE_LIVE_ORIGIN=
PORT=8080
DATABASE_URL=postgres://spinroom:spinroom@localhost:5432/spinroom
REDIS_URL=redis://localhost:6379/0
# openssl rand -hex 32
SESSION_SECRET=
# openssl rand -base64 32   (seals Spotify and Slack tokens at rest)
ENCRYPTION_KEY=
LOG_LEVEL=info

# ---------------------------------------------------------------- Spotify
# real = each user brings their own Client ID (option B). fake = no Spotify needed (dev/tests).
SPOTIFY_MODE=fake
# Staging smoke tests only: allow SPOTIFY_MODE=fake with NODE_ENV=production.
ALLOW_FAKE_SPOTIFY=
# Option A, local development only: a shared Client ID used when a user has none.
SPOTIFY_DEV_CLIENT_ID=
# Comma-separated Spotify user IDs that get admin (avatar review queue).
ADMIN_SPOTIFY_IDS=

# ---------------------------------------------------------------- internal services
# Shared secrets the Slack and MCP services use to call the API (token exchange).
SERVICE_SECRET_SLACK=
SERVICE_SECRET_MCP=
# Public URL of the MCP endpoint (audience of MCP OAuth tokens).
MCP_RESOURCE_URL=http://127.0.0.1:8090/mcp

# ---------------------------------------------------------------- object storage (avatars)
STORAGE_DRIVER=fs
STORAGE_DIR=.data/blobs
ASSET_BASE_URL=/v1/assets
# For STORAGE_DRIVER=s3 (S3, R2, MinIO):
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------- cookies
# true in production (HTTPS)
COOKIE_SECURE=false

# ---------------------------------------------------------------- Slack app (apps/slack)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_STATE_SECRET=
SLACK_PORT=8070
SPINROOM_API_URL=http://127.0.0.1:8080

# ---------------------------------------------------------------- MCP server (apps/mcp)
MCP_PORT=8090
# stdio build: personal access token from Profile → Connect agent
SPINROOM_TOKEN=
